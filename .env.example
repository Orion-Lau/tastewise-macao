# Your public API gateway or same-origin backend. Do not end with a slash.
# 本地联调可用参考后端：npm run server 后填 http://localhost:8788
VITE_API_BASE_URL=https://api.example.com

# Optional: only use a public/short-lived browser token here.
# Keep permanent secrets in your server-side proxy, never in VITE_* variables.
VITE_API_TOKEN=

# ── QwenPaw 智能体平台（仅服务端读取，绝不放进 VITE_* 浏览器变量）──────────
# 不配置 = 本地 mock 模式（演示/测试不受影响）；配置后 agent 走真平台，失败自动降级。
# npm run server / npm run agent / npm run eval:live 通过 --env-file-if-exists 自动读 .env。
QWENPAW_API_BASE=
QWENPAW_API_KEY=
QWENPAW_TIMEOUT_MS=30000
# 平台上每个智能体的 ID / 模型名（不填时用智能体名本身）
QWENPAW_AGENT_ASSISTANT=
QWENPAW_AGENT_TRANSLATOR=
QWENPAW_AGENT_MARKETING=
QWENPAW_AGENT_FAQ_GENERATOR=
QWENPAW_AGENT_ONBOARDING=
# menu-extractor 依赖平台视觉能力，二期再接（见 QWENPAW_PLAN.md §4）
QWENPAW_AGENT_MENU_EXTRACTOR=
