# Your public API gateway or same-origin backend. Do not end with a slash.
# 本地聯調可用參考後端：npm run server 後填 http://localhost:8788
VITE_API_BASE_URL=https://api.example.com

# Optional: only use a public/short-lived browser token here.
# Keep permanent secrets in your server-side proxy, never in VITE_* variables.
VITE_API_TOKEN=

# ── QwenPaw 智能體平臺（僅服務端讀取，絕不放進 VITE_* 瀏覽器變量）──────────
# 不配置 = 本地 mock 模式（演示/測試不受影響）；配置後 agent 走真平臺，失敗自動降級。
# npm run server / npm run agent / npm run eval:live 通過 --env-file-if-exists 自動讀 .env。
# 本機 QwenPaw 預設地址；本機控制臺模式不需要在專案中重複保存 API Key。
QWENPAW_API_BASE=http://127.0.0.1:8088
QWENPAW_API_KEY=
QWENPAW_TIMEOUT_MS=120000
# 平臺上每個智能體的 ID / 模型名（不填時用智能體名本身）
QWENPAW_AGENT_ASSISTANT=aoweizhiyi-assistant
QWENPAW_AGENT_TRANSLATOR=aoweizhiyi-translator
QWENPAW_AGENT_MARKETING=aoweizhiyi-marketing
QWENPAW_AGENT_FAQ_GENERATOR=aoweizhiyi-faq
QWENPAW_AGENT_ONBOARDING=aoweizhiyi-onboarding
# menu-extractor 依賴平臺視覺能力，二期再接（見 QWENPAW_PLAN.md §4）
QWENPAW_AGENT_MENU_EXTRACTOR=

